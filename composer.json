{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-readable-anchor",
    "description": "Lesbare Sprungmarken (Anker-IDs) für alle Inhaltselemente – aus der Überschrift oder einem eigenen Feld.",
    "keywords": ["TYPO3 CMS", "Extension", "anchor"],
    "homepage": "https://www.hauer-heinrich.de",
    "license": ["GPL-2.0-or-later"],
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "http://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_readable_anchor/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_readable_anchor",
        "docs": "https://github.com/Hauer-Heinrich/hh_readable_anchor/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-frontend": "^12.4 || ^13.4",
        "typo3/cms-fluid-styled-content": "^12.4 || ^13.4"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhReadableAnchor\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_readable_anchor",
            "version": "1.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
